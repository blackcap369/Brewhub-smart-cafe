# Razorpay Configuration
# Get these from your Razorpay Dashboard: https://dashboard.razorpay.com/

# Test/Live Key ID (public key)
RAZORPAY_KEY_ID=your_razorpay_key_id_here

# Test/Live Key Secret (private key - keep secure!)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Webhook Secret (from Razorpay Dashboard > Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Supabase Configuration (automatically set in Edge Functions)
# SUPABASE_URL=your_supabase_url
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
