# =============================================================================
# BrewHub Environment Variables
# =============================================================================

# Supabase Configuration
# Get these from your Supabase project dashboard: https://supabase.com/dashboard/
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Razorpay Configuration
# Get these from your Razorpay dashboard: https://dashboard.razorpay.com/
# This is the PUBLIC key (starts with rzp_test_ or rzp_live_)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id

# =============================================================================
# Phone OTP Authentication Setup
# =============================================================================
# 
# To enable phone OTP authentication via Supabase:
#
# 1. Go to Supabase Dashboard → Authentication → Providers
# 2. Enable "Phone" provider
# 3. Configure SMS provider (Twilio, MessageBird, or Vonage)
#    - For Twilio:
#      - Account SID
#      - Auth Token
#      - Phone Number (sender)
#    - For testing, you can add test phone numbers:
#      Dashboard → Authentication → Phone Providers → SMS
#      Add test numbers like: +911234567890 with OTP: 123456
#
# 4. For development/testing without SMS:
#    - Enable "Enable Phone Provider" in Supabase
#    - Add test phone numbers with fixed OTPs
#    - Or use Supabase's built-in OTP for development
#
# 5. Rate Limits:
#    - Supabase allows 3 OTP requests per phone number per hour
#    - Configure in Dashboard → Authentication → Rate Limits
#
# =============================================================================
